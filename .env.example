# SentinelShare Environment Variables
# Copy this file to .env.local or set these in your deployment platform (e.g. Vercel)

# --- Optional Frontend Analytics (Umami) ---
# If left empty, analytics script tag is omitted
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Optional Authentication / Portal ---
VITE_OAUTH_PORTAL_URL=https://auth.example.com
VITE_APP_ID=your-app-id
VITE_APP_TITLE=SentinelShare

# --- Optional Map / Geolocation Proxy (if Map component is enabled) ---
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com

# --- Local Server Configuration ---
PORT=3000
NODE_ENV=development
